{
  "id": null,
  "uid": "identity-operations",
  "title": "Identity Operations",
  "tags": ["identity", "operations"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(unikorn_controller_ready{service=\"unikorn-identity\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "title": "Ready controllers",
      "description": "All three controller types must be ready; readiness follows cache sync and leader acquisition.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "0/3"},
                "1": {"text": "1/3"},
                "2": {"text": "2/3"},
                "3": {"text": "3/3"}
              }
            }
          ]
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster) (unikorn_controller_ready{service=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "title": "Controller builds",
      "description": "The running version and revision for each controller process.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (controller, version, revision) (unikorn_identity_controller_build_info{service=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Server ready",
      "description": "Ready API replicas own their bound HTTP listener. Scraped counts server build-info series, including surge and draining pods, not desired replicas. Ready % is red at zero, amber below 100%, and green at 100%. Missing scrapes are not counted.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Ready %"},
            "properties": [
              {"id": "unit", "value": "percentunit"},
              {"id": "decimals", "value": 1},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "color", "value": {"mode": "thresholds"}},
              {"id": "thresholds", "value": {
                "mode": "absolute",
                "steps": [{"color": "yellow", "value": null}, {"color": "green", "value": 1}]
              }},
              {"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "0%", "color": "red"}}}]}
            ]
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster) (unikorn_server_ready{service=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (cluster) (unikorn_identity_server_build_info{service=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster) (unikorn_server_ready{service=\"unikorn-identity\", cluster=~\"$cluster\"}) / count by (cluster) (unikorn_identity_server_build_info{service=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true},
            "indexByName": {"cluster": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3},
            "renameByName": {"cluster": "Cluster", "Value #A": "Ready", "Value #B": "Scraped", "Value #C": "Ready %"}
          }
        }
      ],
      "options": {"showHeader": true}
    },
    {
      "id": 5,
      "title": "Server builds",
      "description": "The running version and revision for each API server process.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (version, revision) (unikorn_identity_server_build_info{service=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}
