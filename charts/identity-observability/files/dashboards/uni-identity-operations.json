{
  "id": null,
  "uid": "identity-operations",
  "title": "Identity Operations",
  "tags": ["identity", "operations"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "query": "label_values(unikorn_controller_ready{job=\"unikorn-identity\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 2,
      "title": "Ready controllers",
      "description": "All three controller types must be ready; readiness follows cache sync and leader acquisition.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "0/3"},
                "1": {"text": "1/3"},
                "2": {"text": "2/3"},
                "3": {"text": "3/3"}
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (cluster) (unikorn_controller_ready{job=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "title": "Controller builds",
      "description": "The running version and revision for each controller process.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "max by (controller, version, revision) (unikorn_identity_controller_build_info{job=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Server ready",
      "description": "The single API server must own its bound HTTP listener.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "0/1"},
                "1": {"text": "1/1"}
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (cluster) (unikorn_server_ready{job=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "legendFormat": "{{cluster}}",
          "refId": "A"
        }
      ],
      "options": {
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 5,
      "title": "Server builds",
      "description": "The running version and revision for each API server process.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "max by (version, revision) (unikorn_identity_server_build_info{job=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    }
  ]
}
