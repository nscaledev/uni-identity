{
  "id": null,
  "uid": "uni-identity-api",
  "title": "Identity API",
  "tags": [
    "identity",
    "authentication"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "query": "label_values(http_server_request_duration_seconds_count{job=\"unikorn-identity\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "description": "All Identity API requests per second across the selected clusters.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx Error Rate",
      "description": "Share of requests that failed inside Identity. Break this down by route before investigating.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\", status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "4xx Error Rate",
      "description": "Share of requests rejected for client-facing reasons. A raised floor usually points to a caller or upstream identity provider.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\", status_class=\"4xx\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "p95 Latency",
      "description": "95th percentile API duration across all routes in the selected clusters.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request Rate by Route",
      "description": "Traffic volume by templated API route and response class.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (route, status_class) (rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Error Rate by Status Class",
      "description": "The 4xx and 5xx shares over time, separated so caller failures do not hide service failures.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "100 * sum by (status_class) (rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\", status_class=~\"[45]xx\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "5xx Rate by Route",
      "description": "Routes producing server errors. A non-zero line identifies the API operation to investigate.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\", status_class=\"5xx\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "4xx Rate by Route",
      "description": "Routes rejecting requests. Compare with federation and caller behaviour before treating these as service faults.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\", status_class=\"4xx\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "p95 Latency by Route",
      "description": "The slowest API routes at the 95th percentile.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Latency Quantiles",
      "description": "p50, p90, and p99 API duration across all routes.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"unikorn-identity\", cluster=~\"$cluster\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 11,
      "title": "Active Requests by Route",
      "description": "Concurrent requests by route. Rising latency with rising concurrency indicates queued or blocked work.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (route) (http_server_active_requests{job=\"unikorn-identity\", cluster=~\"$cluster\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "401 Rate by Route",
      "description": "Failed authentication per route: missing, invalid, expired or untrusted tokens. A rise on one route points at one caller; a rise on all routes points at token issuing or the trust list.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\", code=\"401\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "403 Rate by Route",
      "description": "Denied authorization per route: the caller is authenticated but lacks the permission. A rise after a role or ACL change points at that change.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_server_request_duration_seconds_count{job=\"unikorn-identity\", cluster=~\"$cluster\", code=\"403\"}[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
