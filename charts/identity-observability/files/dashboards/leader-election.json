{
  "id": null,
  "uid": "identity-controller-leadership",
  "title": "Identity Leadership",
  "tags": ["identity", "controllers", "server", "leadership"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(leader_election_master_status{service=\"unikorn-identity\", name!=\"\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active leaders",
      "description": "Expected: four leaders per cluster, one for each of the three controller types and one for JOSE signing-key rotation. Counts all replicas reporting leadership across the selected clusters; inspect each lease for missing or simultaneous leaders.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(leader_election_master_status{service=\"unikorn-identity\", name!=\"\", cluster=~\"$cluster\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Leadership by lease",
      "description": "Counts replicas reporting leadership for each controller or JOSE lease across selected clusters. Select one cluster: 0 means no leader, 1 means one leader, and 2 or more means simultaneous leaders.",
      "type": "state-timeline",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (name) (leader_election_master_status{service=\"unikorn-identity\", name!=\"\", cluster=~\"$cluster\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    }
  ]
}
